<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
  <meta charset="utf-8">
  <title>{{meta_title}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Allura&family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
  {{ghost_head}}
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
</head>
<body class="{{body_class}}">

<div class="legal-ambient" aria-hidden="true">
  <div class="legal-photo legal-photo-books"></div>
  <div class="legal-photo legal-photo-library"></div>
  <div class="legal-photo legal-photo-seal"></div>
  <div class="legal-photo legal-photo-books-small"></div>
  <div class="legal-grid"></div>
  <div class="legal-orbit legal-orbit-one"></div>
  <div class="legal-orbit legal-orbit-two"></div>
  <div class="legal-float legal-float-scale">
    <span class="legal-symbol">SCALES</span>
    <span class="legal-caption">Balance &middot; Justice</span>
  </div>
  <div class="legal-float legal-float-file">
    <span class="legal-file-mark">CASE</span>
    <span class="legal-caption">Prepared with care</span>
  </div>
  <div class="legal-float legal-float-book">
    <span class="legal-symbol">LAW</span>
    <span class="legal-caption">Knowledge &middot; Counsel</span>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <a href="{{@site.url}}" class="wordmark wordmark-lockup">
      <img class="brand-mark" src="{{asset "images/download (25).jpg"}}" alt="Garcia Law Office and Notary Public seal logo">
      <span class="wordmark-copy">
        <span>Garcia Law Office</span>
        <small class="brand-tagline">Justice Through Integrity</small>
      </span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">&#9776;</button>
    <nav class="main-nav" id="mainNav">
      <ul class="nav nav-page-links">
        <li><a href="{{@site.url}}/"><span class="nav-icon" aria-hidden="true">&#9672;</span>Home</a></li>
        <li><a href="{{@site.url}}/services/"><span class="nav-icon" aria-hidden="true">&#9878;</span>Services</a></li>
        <li><a href="{{@site.url}}/lawyers/"><span class="nav-icon" aria-hidden="true">&#9673;</span>Lawyers</a></li>
        <li><a href="{{@site.url}}/gallery/"><span class="nav-icon" aria-hidden="true">&#9638;</span>Gallery</a></li>
        <li><a href="{{@site.url}}/laws/"><span class="nav-icon" aria-hidden="true">&#167;</span>Legal Guides</a></li>
        <li><a href="{{@site.url}}/blog/"><span class="nav-icon" aria-hidden="true">&#9998;</span>Blog</a></li>
        <li><a href="{{@site.url}}/information/"><span class="nav-icon" aria-hidden="true">&#10022;</span>Information</a></li>
        <li><a href="{{@site.url}}/faq/"><span class="nav-icon" aria-hidden="true">&#63;</span>FAQ</a></li>
        <li><a href="{{@site.url}}/contact/"><span class="nav-icon" aria-hidden="true">&#9993;</span>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main>
{{{body}}}
</main>

<footer class="site-footer">
  <div class="container">
    <span class="wordmark wordmark-lockup">
      <img class="brand-mark" src="{{asset "images/download (25).jpg"}}" alt="">
      <span>Garcia Law Office and Notary Public</span>
    </span>
    <span>{{@custom.office_address}}</span>
    <a href="{{@site.url}}/privacy/">Privacy &amp; Disclaimer</a>
  </div>
</footer>

<script src="{{asset "js/main.js"}}"></script>
{{ghost_foot}}
</body>
</html>
