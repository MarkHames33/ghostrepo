{{!< default}}

<section class="page-section private-client-section" data-private-client>
  <div class="container container-narrow">
    <div class="private-client-panel">
      <p class="eyebrow">Private client area</p>
      <h1 class="page-title">Your client dashboard</h1>
      <p>Welcome to your private client area. Case updates and documents shared by the office will appear here.</p>
      <div class="private-client-grid">
        <article>
          <span class="private-client-label">Updates</span>
          <h2>Case updates</h2>
          <p>No updates have been posted yet.</p>
        </article>
        <article>
          <span class="private-client-label">Documents</span>
          <h2>Shared documents</h2>
          <p>No documents have been shared yet.</p>
        </article>
      </div>
      <p id="privateClientStatus" class="login-status" role="status" aria-live="polite">Checking your secure session...</p>
    </div>
  </div>
</section>
